# 环境与密钥
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.coverage

# Node / Next.js
node_modules/
web/.next/
web/out/
web/next-env.d.ts
*.tsbuildinfo

# publish 的临时目录（先写临时目录、校验通过才替换 web/public，正常情况下不留痕）
web/.publish-stage-*/

# 数据与产物（公开 JSON 由 publish 生成，需提交 web/public/data）
data/runs/*.json
!data/runs/.gitkeep
eval/gold_candidates.xlsx
eval/gold.jsonl
eval/cache/

# 系统
.DS_Store

# 阶段 6 验收截图（计划 §阶段 6 要求存 screenshots/），14 张约 2.9MB
# 阶段 9 会把最终截图放到 screenshots/final/

# 评测样本含第三方文章全文（版权归各发布方），只留本地，不提交
eval/samples-direction.json
eval/samples-*.json

# data/items 会被提交：流水线靠它保持状态（不提交则 Actions 每次从零开始，
# 首次导入全部归档、永远不出新条目）。
# 安全性由 strip_bodies() 保证：处理完成的条目正文会被清空，只留 bodyChars 长度，
# 因此这里不含第三方文章全文（用户 2026-10-21 确认的策略）。
# 仍需处理的条目（new/prefiltered/scored/unknown）会短暂保留正文，属必要输入。
