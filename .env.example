# 环境变量模板。复制成 .env 后填入自己的值；.env 不会被提交。
#
# 真实调用需要同时满足三个条件（计划 §2.3）：
#   1. 脚本显式传 --execute
#   2. 环境里有 LLM_API_KEY
#   3. MODEL_CALLS_ENABLED=true
#
# 只做抓取与机械步骤时，保持 MODEL_CALLS_ENABLED=false 即可，零模型调用。

# OpenAI 兼容端点。DeepSeek 用 https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com

# 你自己的 key。GitHub Actions 里放 Secrets 的 LLM_API_KEY，不要写进仓库。
LLM_API_KEY=

# 默认模型
LLM_MODEL=deepseek-flash

# 可选：评分步骤单独换模型（D8）
# SCORE_MODEL=

# 可选：按步骤覆盖模型
# WRITE_MODEL=
# PREFILTER_MODEL=

# 安全阀，默认关闭
MODEL_CALLS_ENABLED=false
